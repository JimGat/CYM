menu "CYM Board Selection"

    choice BOARD_SELECT
        prompt "Target board"
        default BOARD_NM_CYD_C5
        help
            Select the target hardware board. This controls pin definitions,
            capability flags, and HAL driver selection throughout the firmware.
            New boards: add a header under include/boards/, add a choice entry
            here, dispatch in include/board_hal.h, add sdkconfig.defaults.<name>.

        config BOARD_NM_CYD_C5
            bool "NM-CYD-C5 (NerdMiner ESP32-C5 CYD) [PRIMARY]"
            help
                NM-CYD-C5 with NM-RF-HAT support. WiFi 6 dual-band, XPT2046
                resistive touch, ST7789 display, WS2812 LED, ERM vibrator.

        config BOARD_WS_C5_28
            bool "Waveshare ESP32-C5-Touch-LCD-2.8 [Phase 2]"
            help
                Waveshare ESP32-C5 2.8\" board. CST3530 capacitive touch,
                ST7789 display, CH32V003 IO expander for backlight, ES8311 audio.
                Note: LCD CS and SD CS are swapped vs NM-CYD-C5.

        config BOARD_CYD2USB
            bool "ESP32-2432S028R Classic CYD (CYD2USB) [Phase 3]"
            help
                Cheap Yellow Display with dual USB — ESP32 (single-core), ILI9341
                2.8\" 240x320, XPT2046 resistive touch, 4 MB flash, no PSRAM.
                Display+touch share VSPI (SPI3_HOST); SD card on separate HSPI
                (SPI2_HOST). RGB LED active-LOW common-anode on GPIO 4/16/17.

        config BOARD_HOSYOND_S3_35
            bool "Hosyond 3.5\" ES3C35P (ESP32-S3, ST77922 QSPI) [Phase 4]"
            help
                Hosyond 3.5\" ESP32-S3 display board (SKU ES3C35P). ST77922 QSPI
                display (320x480), custom I2C touch (0x55), SD on SPI3, WS2812
                RGB LED on IO40. 8 MB OPI PSRAM, 16 MB flash, dual-core LX7 240 MHz.

        config BOARD_HOSYOND_S3_28
            bool "Hosyond 2.8\" (ESP32-S3, ILI9341V + FT6336G) [Pending GPIO]"
            help
                Hosyond 2.8\" ESP32-S3 board (ASIN B0FKG7WRWV). ILI9341V SPI
                display, FT6336G capacitive touch. GPIO map to be confirmed on
                hardware arrival.

        config BOARD_HOSYOND_S3_40
            bool "Hosyond 4.0\" (ESP32-S3) [Not yet owned]"
            help
                Hosyond 4.0\" ESP32-S3 board. GPIO map TBD on hardware arrival.

    endchoice

    # ── Capability flags — automatically derived from board selection ──────────
    # These control #ifdef blocks throughout the firmware for board-specific
    # behaviour. Do not set them directly; they follow BOARD_SELECT.

    config BOARD_HAS_PSRAM
        bool
        default y if BOARD_NM_CYD_C5 || BOARD_WS_C5_28 || BOARD_HOSYOND_S3_35 || BOARD_HOSYOND_S3_28 || BOARD_HOSYOND_S3_40
        help
            Board has PSRAM. Enables large buffer allocations, LVGL PSRAM draw
            buffers, and the 1 MB captive-portal HTML buffer.

    config BOARD_HAS_5GHZ
        bool
        default y if BOARD_NM_CYD_C5 || BOARD_WS_C5_28
        help
            WiFi 6 dual-band (2.4 + 5 GHz). Set band mode WIFI_BAND_MODE_AUTO.
            ESP32-C5 only. ESP32, ESP32-S3 are 2.4 GHz only (default n).

    config BOARD_HAS_DUAL_CORE
        bool
        default y if BOARD_CYD2USB || BOARD_HOSYOND_S3_35 || BOARD_HOSYOND_S3_28 || BOARD_HOSYOND_S3_40
        help
            Dual-core SoC (ESP32 / ESP32-S3). When set, the nRF24 jammer task
            should be pinned to Core 1 via xTaskCreatePinnedToCore to isolate it
            from LVGL/WiFi/BLE on Core 0 for better sweep timing.

    config BOARD_HAS_802154
        bool
        default y if BOARD_NM_CYD_C5 || BOARD_WS_C5_28
        help
            Built-in 802.15.4 radio (Zigbee/Thread passive scanner).
            ESP32-C5 only. Not present on ESP32 (CYD2USB) or ESP32-S3 (Hosyond).

    config BOARD_HAS_VIBRATOR
        bool
        default y if BOARD_NM_CYD_C5
        help
            ERM vibrator motor driven via SC8002B amp on BOARD_VIBRATOR_GPIO.
            Haptic feedback for BT Lookout, deauth launch, BT locator proximity.

    config BOARD_HAS_RGB_LED
        bool
        default y if BOARD_NM_CYD_C5 || BOARD_CYD2USB || BOARD_HOSYOND_S3_35
        help
            Addressable or discrete RGB LED. NM-CYD-C5 / Hosyond-S3-35: WS2812
            (NeoPixel) on BOARD_RGB_LED_GPIO. CYD2USB: common-anode RGB LED
            (active-LOW) on GPIO 4/16/17.

    config BOARD_LCD_INVERT_COLOR
        bool
        help
            Invert LCD color output. ILI9341 panels on CYD family boards come in
            both normal and color-inverted variants. Set y for boards confirmed to
            need inversion; n for normal panels. Calls esp_lcd_panel_invert_color().
            CYD2USB (2432S028): inversion IS required — set y in sdkconfig.defaults.cyd2usb.

    config BOARD_LCD_BRIGHTNESS_DEFAULT
        int "Default LCD brightness on first boot (%)"
        range 10 100
        default 55 if BOARD_CYD2USB
        default 80
        help
            Factory default brightness used when NVS has no saved brightness value
            (first boot, or after a factory reset). Each board can have a different
            default to account for panel characteristics and ambient use cases.
            CYD2USB: 55% (ILI9341 panel is notably brighter than ST7789 at the same
            duty cycle). NM-CYD-C5 / WS-C5-28: 80%.

    config BOARD_HAS_DUAL_SPI_BUS
        bool
        default y if BOARD_CYD2USB || BOARD_HOSYOND_S3_35 || BOARD_HOSYOND_S3_28 || BOARD_HOSYOND_S3_40
        help
            Board uses two separate SPI buses. CYD2USB: display+touch on VSPI
            (SPI3), SD on HSPI (SPI2). Hosyond S3: display on SPI2 (QSPI),
            SD on SPI3. Single-bus boards share one bus for all peripherals.

    config BOARD_HAS_IMU
        bool
        default y if BOARD_WS_C5_28
        help
            QMI8658 6-axis IMU (Waveshare only).

    config BOARD_HAS_TEMP_HUMIDITY
        bool
        default y if BOARD_WS_C5_28
        help
            SHTC3 temperature + humidity sensor (Waveshare only).

    config BOARD_HAS_RTC
        bool
        default y if BOARD_WS_C5_28
        help
            PCF85063A real-time clock (Waveshare only).

    config BOARD_HAS_AUDIO_CODEC
        bool
        default y if BOARD_WS_C5_28
        help
            ES8311 I2S audio codec + NS4150B amp (Waveshare). Supports mic + speaker.

    config BOARD_HAS_BACKLIGHT_EXPANDER
        bool
        default y if BOARD_WS_C5_28
        help
            LCD backlight controlled via CH32V003 IO expander (I2C 0x24) instead
            of a direct GPIO. Use custom_io_expander_set_pwm() for brightness.

    config BOARD_HAS_IO_EXPANDER
        bool
        default y if BOARD_WS_C5_28
        help
            CH32V003 secondary MCU on I2C 0x24. Controls LCD RST, touch RST,
            audio amp enable, and backlight PWM.

    # ── LCD driver type ────────────────────────────────────────────────────────

    config BOARD_LCD_IS_QSPI
        bool
        default y if BOARD_HOSYOND_S3_35
        help
            Display uses 4-data-line QSPI (ST77922) instead of standard SPI.
            No DC pin — command bytes are embedded in the QSPI protocol.
            BOARD_LCD_D0..D3 carry the data lines; BOARD_LCD_DC is -1.

    # ── Touch driver selection ─────────────────────────────────────────────────

    config BOARD_HAS_RF_HAT
        bool "NM-RF-HAT expansion board"
        default y if BOARD_NM_CYD_C5
        default n
        help
            NM-RF-HAT expansion board. Enables CC1101, nRF24L01+, PN532 NFC, IR,
            and 433 MHz OOK RF modules.

            NM-CYD-C5: connected via FPC2 connector (default y).
            CYD2USB (Classic CYD / Halehound): connected via SD Card Shim that
              routes the HSPI SPI bus through the SD card slot. SD card is relocated
              to the RF-HAT onboard socket. Enable y when building with the shim.
            Waveshare WS-C5-28: connected via JST 12-pin SH1.0 connector + SD shim.

    config BOARD_TOUCH_XPT2046
        bool
        default y if BOARD_NM_CYD_C5 || BOARD_CYD2USB
        help
            XPT2046 resistive SPI touch. Requires 4-point calibration on first
            boot. Position-compensated pressure formula Z1 + 4095 - Z2.

    config BOARD_TOUCH_CST3530
        bool
        default y if BOARD_WS_C5_28
        help
            CST3530 capacitive I2C touch. Interrupt-driven via BOARD_TOUCH_INT.
            No calibration needed.

    config BOARD_TOUCH_I2C
        bool
        default y if BOARD_HOSYOND_S3_35
        help
            Generic capacitive touch on I2C. No SPI CS (BOARD_TOUCH_CS = -1).
            Hosyond S3-35: custom IC at 0x55 (BOARD_TOUCH_I2C_ADDR) on IO38/IO39.
            No calibration needed.

endmenu
