␀I (%lu) %s: AUDIO_STOPPED synchronous_owner DMA_released=%d
␀␀␀␀I (%lu) %s: CODEC_DIAG board=%s read_mask=%03x reg00=%02x reg01=%02x reg02=%02x reg06=%02x reg09=%02x reg0a=%02x reg0d=%02x reg12=%02x reg14=%02x reg31=%02x reg32=%02x reg37=%02x configuration_verified=%d audible=unconfirmed
␀␀␀E (%lu) %s: AUDIO_NOT_READY board=%s reason=codec_readback
␀E (%lu) %s: AUDIO_NOT_READY board=%s reason=amp_pin_readback
␀␀␀I (%lu) %s: I2S_DIAG board=%s TX_ONLY no_mclk rate=%d bits=%d slot_bits=%d slot_mask=%d mono=%d bclk=%d lrclk=%d dout=%d pa_supply=3.3 dac_supply=3.3 configured_clocks_not_wire_measurement
␀␀␀cym_pcm␀I (%lu) %s: AUDIO_STARTED configuration_verified audible=unconfirmed ES8311 rate=%d BCLK=%d LRCLK=%d DOUT=%d volume_db=%.0f SFX_ONLY
␀␀␀E (%lu) %s: AUDIO_INIT_FAILED ES8311/I2S/PA cleanup_rc=%d silent_safe=%u audible=unconfirmed
