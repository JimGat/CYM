# Waveshare ESP32-C5-Touch-LCD-3.5 (experimental)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"
CONFIG_BOARD_WS_C5_35=y

# Keep application and IDF bootloader console off the GPS expansion UART.
# CONFIG_ESP_CONSOLE_UART_DEFAULT is not set
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y
# CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG is not set

# QR decode keeps its 24KB workspace on PSRAM; TCB/ISRs/DMA stay internal.
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y

# Independent QR engine: runtime enabled only on WS35, code generation scoped
# to its private archives by CMake. Keep the standard emergency reserve ABI.
CONFIG_COMPILER_CXX_EXCEPTIONS=y
CONFIG_COMPILER_CXX_EXCEPTIONS_EMG_POOL_SIZE=2048
# CONFIG_COMPILER_CXX_RTTI is not set
