# Waveshare ESP32-C5-Touch-LCD-2.8 board-specific sdkconfig overrides
# Layered on top of sdkconfig.defaults (the shared ESP32-C5 base config).
#
# Board: Waveshare ESP32-C5-Touch-LCD-2.8
# SoC:   ESP32-C5-WROOM-1-N8, 32 MB flash, 8 MB PSRAM, WiFi 6 dual-band
# Touch: CST3530 capacitive I2C (no calibration needed), interrupt GPIO5
# LCD:   ST7789 240x320, backlight via CH32V003 IO expander (I2C 0x24, EXIO_PWM)
# RF:    NM-RF-HAT via SD shim + JST wires (GPIO2/GPIO3 as control signals)
# Extra: QMI8658 IMU, SHTC3 temp/humidity, PCF85063A RTC, ES8311 audio codec
#
# Board received 2026-09-07. Port complete at v2.13.51+.
#
# Key differences from NM-CYD-C5:
#   LCD CS:  GPIO10 (NM-CYD-C5 has LCD CS=23, SD CS=10)
#   SD CS:   GPIO23 (swapped)
#   SD MISO: GPIO8  (NM-CYD-C5 uses GPIO2)
#   Flash:   32 MB  (vs 16 MB on NM-CYD-C5)

# 32 MB flash (Waveshare has more flash than NM-CYD-C5)
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="32MB"

# board_hal Kconfig — select Waveshare C5-28 board variant
CONFIG_BOARD_WS_C5_28=y

# This board's ST7789 module is a color-inverted variant (confirmed on real
# hardware 2026-09-15, Jim: first boot after the RST fixes showed colors as a
# photographic negative — black displayed as white, blue as red). Same class
# of issue the BOARD_LCD_INVERT_COLOR Kconfig help text already documents for
# CYD2USB's ILI9341: panels from this supply chain come in both normal and
# inverted polarity, and NM-CYD-C5's ST7789 (which does NOT set this) is
# evidently the other polarity from this board's ST7789, despite both being
# "ST7789." Calls esp_lcd_panel_invert_color(handle, true) in init_display().
CONFIG_BOARD_LCD_INVERT_COLOR=y
