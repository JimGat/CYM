# Minimal pinned build-tree copy; never edit installed managed LVGL originals.
idf_component_get_property(cym_lvgl_dir lvgl__lvgl COMPONENT_DIR)
idf_component_get_property(cym_lvgl_lib lvgl__lvgl COMPONENT_LIB)
set(cym_refr "${cym_lvgl_dir}/src/core/lv_refr.c")
set(cym_diag_refr "${CMAKE_BINARY_DIR}/cym-lvgl-diag/lv_refr.c")
execute_process(COMMAND "${PYTHON}" "${CMAKE_CURRENT_LIST_DIR}/lvgl-diag-copy.py" "${cym_refr}" "${cym_diag_refr}" RESULT_VARIABLE cym_diag_rc)
if(NOT cym_diag_rc EQUAL 0)
    message(FATAL_ERROR "Pinned LVGL diagnostic copy failed; do not compile uninstrumented vendor input")
endif()
get_target_property(cym_lvgl_sources ${cym_lvgl_lib} SOURCES)
# Resolve relative vendor target sources explicitly and require exactly one replacement.
set(cym_diag_sources "")
set(cym_diag_replaced 0)
foreach(cym_src IN LISTS cym_lvgl_sources)
    get_filename_component(cym_abs "${cym_src}" ABSOLUTE BASE_DIR "${cym_lvgl_dir}")
    if(cym_abs STREQUAL cym_refr)
        math(EXPR cym_diag_replaced "${cym_diag_replaced}+1")
    else()
        list(APPEND cym_diag_sources "${cym_src}")
    endif()
endforeach()
if(NOT cym_diag_replaced EQUAL 1)
    message(FATAL_ERROR "Expected exactly one pinned LVGL refresh translation unit; got ${cym_diag_replaced}")
endif()
set(cym_lvgl_sources "${cym_diag_sources}")
set_property(TARGET ${cym_lvgl_lib} PROPERTY SOURCES "${cym_lvgl_sources};${cym_diag_refr}")
target_include_directories(${cym_lvgl_lib} PRIVATE "${cym_lvgl_dir}/src/core")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${CMAKE_CURRENT_LIST_DIR}/lvgl-diag-copy.py" "${cym_refr}")
