# CYD2USB (ESP32-2432S028R) board-specific sdkconfig overrides
# Layered on top of sdkconfig.defaults (shared ESP32 base).
#
# Board: ESP32-2432S028R (Cheap Yellow Display, CYD2USB variant)
# SoC:   ESP32-WROOM-32 dual-core Xtensa LX6 240 MHz, 4 MB flash, no PSRAM
# Touch: XPT2046 resistive SPI (requires calibration, same driver as NM-CYD-C5)
# LCD:   ILI9341 SPI 240x320, backlight via GPIO21 or GPIO27 (board variant)
# Audio: None (no amp on standard CYD)
# LED:   RGB LED on GPIO4/16/17 (common CYD wiring — verify on board variant)
#
# Dual-core advantage: jammer task can be pinned to Core 1, isolated from LVGL.
# This enables significantly better nRF24 sweep timing than the single-core C5.
#
# Note: CYD2USB has no PSRAM. Array sizes and buffer allocations in main.c must
# be gated by CONFIG_BOARD_HAS_PSRAM=n and use internal DRAM allocations only.
#
# Phase 3 — fill in when porting begins.

# 4 MB flash (standard CYD)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# PSRAM — CYD2USB (ESP32-WROOM-32) has no PSRAM.
# Large static arrays are size-reduced via CONFIG_BOARD_HAS_PSRAM=n guards in main.c.
# If using a WROVER variant (4 MB PSRAM), add CONFIG_SPIRAM=y here.

# Main task stack — smaller than C5 due to no PSRAM
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Compiler optimization
CONFIG_COMPILER_OPTIMIZATION_PERF=y

CONFIG_BOARD_CYD2USB=y

# Color inversion — NOT needed on Jim's CYD-2432S028 unit.
#
# History: this was set to `y` from v2.13.66 onward on the (mistaken) belief
# that this panel variant needs inversion. That belief was never actually
# hardware-verified: CONFIG_BOARD_LCD_INVERT_COLOR was a Kconfig `bool` with
# no prompt string the entire time (fixed in v2.13.99), which meant it could
# never be set via sdkconfig.defaults no matter what this file said — the
# option silently stayed at its unset/false default, so every CYD-2432S028
# build through v2.13.98 actually ran with NO inversion applied, regardless
# of this line. v2.13.99's Kconfig fix made the flag real for the first time,
# which actually inverted colors on real hardware — and broke a display that
# had been correct the entire time. Jim confirmed on real hardware that
# v2.13.70 (running with the bug, i.e. no inversion) looked perfect. Left
# explicitly `n` here so a future contributor doesn't flip it back on a stale
# assumption. If a different panel-variant unit is confirmed (by someone
# actually looking at their screen post-v2.13.99) to need inversion, that's a
# real per-unit hardware difference, not a firmware default to restore blindly.
CONFIG_BOARD_LCD_INVERT_COLOR=n

# Disable WiFi IRAM speed optimizations to free ~10-17 KB IRAM each.
# Saves >10 KB (IRAM_OPT) + >17 KB (RX_IRAM_OPT) at the cost of reduced WiFi throughput.
# Required on CYD2USB (no PSRAM, tight IRAM budget). Acceptable: CYD is a local-range
# toolkit, not a high-throughput device.
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
