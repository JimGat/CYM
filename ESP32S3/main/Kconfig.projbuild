menu "CYM Board Selection (ESP32-S3)"

    choice BOARD_S3_SELECT
        prompt "ESP32-S3 board variant"
        default BOARD_HOSYOND_S3_35

        config BOARD_HOSYOND_S3_35
            bool "Hosyond 3.5\" ES3C35P (ST77922 QSPI, 320x480)"

        config BOARD_HOSYOND_S3_28
            bool "Hosyond 2.8\" (ILI9341V SPI, 240x320) — pending GPIO confirm"

    endchoice

endmenu
